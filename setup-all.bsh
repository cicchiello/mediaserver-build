#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

d=$(dirname $0)

echo "INFO: invoking ${d}/setup0.bsh"
${d}/setup0.bsh

echo "INFO: setting up the networking"
${d}/setup-network.bsh

echo "INFO: invoking ${d}/setup-couchdb.bsh"
${d}/setup-couchdb.bsh

echo "INFO: invoking ${d}/setup-dvr.bsh"
${d}/setup-dvr.bsh

echo "INFO: All done!"
