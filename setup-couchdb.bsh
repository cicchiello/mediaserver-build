#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

t=$(date)
echo "INFO: starting CouchDb install: ${t}"

##
## CouchDb install
##

dir=$(dirname $0)

curl https://couchdb.apache.org/repo/keys.asc | gpg --dearmor | tee /usr/share/keyrings/couchdb-archive-keyring.gpg >/dev/null 2>&1

source /etc/os-release

echo "deb [signed-by=/usr/share/keyrings/couchdb-archive-keyring.gpg] https://apache.jfrog.io/artifactory/couchdb-deb/ ${VERSION_CODENAME} main" \
| tee /etc/apt/sources.list.d/couchdb.list >/dev/null


# load installation-specific secrets (${dir}/couchdb-secrets.sh isn't placed in the repo)
#   Defines:
#      COUCHDB_PASSWORD
#      COUCHDB_COOKIE
#      
source ${dir}/couchdb-secrets.sh


# 2. Pre-seed the configuration answers into the debconf database
debconf-set-selections <<EOF
couchdb couchdb/mode select standalone
couchdb couchdb/mode seen true
couchdb couchdb/nodename string couchdb@127.0.0.1
couchdb couchdb/nodename seen true
couchdb couchdb/cookie string ${COUCHDB_COOKIE}
couchdb couchdb/cookie seen true
couchdb couchdb/bindaddress string 0.0.0.0
couchdb couchdb/bindaddress seen true
couchdb couchdb/adminpass password ${COUCHDB_PASSWORD}
couchdb couchdb/adminpass seen true
couchdb couchdb/adminpass_again password ${COUCHDB_PASSWORD}
couchdb couchdb/adminpass_again seen true
EOF


# 3. Install CouchDB completely non-interactively
apt update
DEBIAN_FRONTEND=noninteractive apt-get install -y couchdb > /tmp/install-couchdb


# confirm couchdb install 
curl http://127.0.0.0:5984


##
## Java 8.x install
##

##### Add the Adoptium signing key and repository
####mkdir -p /etc/apt/keyrings
####curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public | tee /etc/apt/keyrings/adoptium.asc > /dev/null
####
####echo "deb [signed-by=/etc/apt/keyrings/adoptium.asc] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" | tee /etc/apt/sources.list.d/adoptium.list > /dev/null
####
##### Update and install Java 8 JRE
####apt install -y temurin-8-jre unzip

# Install the official, native Java 21 headless runtime package
apt update
sudo apt install -y openjdk-21-jre-headless

##
## Clouseau install
##

# Fetch the Clouseau package (adjust the version if a newer specific target is needed)
#  example url: https://github.com/cloudant-labs/clouseau/releases/download/3.5.0/clouseau-3.5.0-dist.zip
CLOUSEAU_VERSION="3.5.0"
CLOUSEAU_ROOT_URL="https://github.com/cloudant-labs/clouseau/releases/download"
CLOUSEAU_URL="${CLOUSEAU_ROOT_URL}/${CLOUSEAU_VERSION}/clouseau-${CLOUSEAU_VERSION}-dist.zip"
wget ${CLOUSEAU_URL} -O /tmp/clouseau.zip 


# Extract it to /opt
unzip /tmp/clouseau.zip -d /opt/
ln -s /opt/clouseau-${CLOUSEAU_VERSION} /opt/clouseau
chown -R couchdb:couchdb /opt/clouseau-${CLOUSEAU_VERSION}

# prepare clouseau.conf
echo "DEBUG: Using COUCHDB_COOKIE=${COUCHDB_COOKIE}"
cat ${dir}/clouseau.conf | sed "s/COUCHDB_COOKIE/${COUCHDB_COOKIE}/g" > /opt/clouseau/clouseau.conf
echo "DEBUG: got past the clouseau.conf setup"

##### prepare clouseau.ini
####echo "DEBUG: Using COUCHDB_COOKIE=${COUCHDB_COOKIE}"
####cat ${dir}/clouseau-example.ini | sed "s/COUCHDB_COOKIE/${COUCHDB_COOKIE}/g" > /opt/clouseau/clouseau.ini
####echo "DEBUG: got past the clouseau.ini setup"

# prepare clouseau's log4j
cp ${dir}/clouseau-log4j.properties /opt/clouseau/log4j.properties

# point couchdb at clouseau
tee -a /opt/couchdb/etc/local.ini > /dev/null <<EOF

[dreyfus]
name = clouseau@127.0.0.1
EOF



# setup clouseau to be started by systemd
tee /etc/systemd/system/clouseau.service > /dev/null <<EOF
[Unit]
Description=Clouseau Full-Text Search Service for CouchDB
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/clouseau
ExecStart=/bin/sh -c "java -server -Xmx2g -Dsun.net.inetaddr.ttl=30 -Dfile.encoding=UTF-8 -cp 'lib/*' com.cloudant.clouseau.Main clouseau.ini"
Restart=always
RestartSec=5
User=couchdb

[Install]
WantedBy=multi-user.target
EOF


# Start everything
systemctl daemon-reload
systemctl enable clouseau.service
systemctl start clouseau.service

# Restart CouchDB to pick up the changes
systemctl restart couchdb


# {"all_nodes":["couchdb@127.0.0.1"],"cluster_nodes":["couchdb@127.0.0.1"]}
# validate
/tmp/expected <<EOF
{
  "all_nodes": [
    "couchdb@127.0.0.1",
    "clouseau@127.0.0.1"
  ],
  "cluster_nodes": [
    "couchdb@127.0.0.1"
  ]
}
EOF

curl -s -u admin:${COUCHDB_PASSWORD} http://127.0.0.1:5984/_membership



##
## Done
##

# if we get here, everything worked!
t=$(date)
echo "INFO: CouchDb installed: ${t}"
