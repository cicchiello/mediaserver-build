#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit 1
fi

if ! systemctl is-active --quiet NetworkManager
then
    echo "ERROR: NetworkManager isn't running"
    exit 1
fi


t=$(date)
echo "INFO: starting network setup: ${t}"

dir=$(dirname $0)


##
## Load installation-specific settings
##   Defines: ETH_IFACE ETH_ADDRESS ETH_GATEWAY ETH_DNS
##            WIFI_IFACE WIFI_SSID WIFI_PASSWORD WIFI_COUNTRY WIFI_ADDRESS WIFI_GATEWAY
##
## Note: ${dir}/network-config.sh isn't placed in the repo; but see network-config-example.sh
##       for reference
source ${dir}/imp/network-config.sh

# replace any existing profile of the same name, so reruns are harmless
recreate() {
    nmcli -t -f NAME connection show | grep -qx "$1" && nmcli connection delete "$1" > /dev/null
}


##
## Ethernet (possibly static)
##
if [ -n "${ETH_IFACE}" ]
then 
    echo "INFO: configuring ${ETH_IFACE} as ${ETH_ADDRESS}"
    recreate mediaserver-eth
    nmcli connection add type ethernet ifname ${ETH_IFACE} con-name mediaserver-eth \
          ipv4.method manual ipv4.addresses ${ETH_ADDRESS} ipv4.gateway ${ETH_GATEWAY} \
          ipv4.dns "${ETH_DNS}" ipv6.method disabled connection.autoconnect yes > /dev/null
fi


##
## WiFi
##
if [ -n "${WIFI_IFACE}" ]
then
    echo "INFO: configuring ${WIFI_IFACE} for ${WIFI_SSID}"
    # the regulatory domain must be set or the radio stays blocked on a fresh image
    iw reg set ${WIFI_COUNTRY} 2>/dev/null
    rfkill unblock wifi
    nmcli radio wifi on

    recreate mediaserver-wifi
    nmcli connection add type wifi ifname ${WIFI_IFACE} con-name mediaserver-wifi ssid "${WIFI_SSID}" \
          wifi-sec.key-mgmt wpa-psk wifi-sec.psk "${WIFI_PASSWORD}" connection.autoconnect yes > /dev/null
    if [ -n "${WIFI_ADDRESS}" ]
    then
        nmcli connection modify mediaserver-wifi ipv4.method manual ipv4.addresses ${WIFI_ADDRESS} \
              ipv4.gateway ${WIFI_GATEWAY} ipv4.dns "${ETH_DNS}"
    fi
fi


##
## Done' Bring up ifaces yet (leave that to the user, manually) 'cause we'll likely lose connection;
## just report state
##
## (Leave's whatever connection we're currently using alone.)
##
sleep 5
echo "INFO: current IFACE state:"
nmcli -f NAME,DEVICE,STATE connection show --active
ip -4 -br addr


##
## /etc/hosts
##
host=$(hostname)
echo "127.0.1.1 ${host}" >> /etc/cloud/templates/hosts.debian.tmpl
cat "${dir}/imp/hosts" >> /etc/cloud/templates/hosts.debian.tmpl

cloud-init single --name cc_update_etc_hosts
echo "INFO: defined /etc/hosts"


##
## mount points
##
file="${dir}/imp/mounts"
while IFS= read -r mount; do
    if [[ "$mount" == "#"* ]]; then
        continue
    fi
    
    echo "INFO: adding mount point: $mount"
    mkdir -p $mount
    chmod 777 $mount
done < "$file"


##
## setup fstab
##
cat "${dir}/imp/fstab" >> /etc/fstab

sleep 1
systemctl daemon-reload

sleep 1
mount -a

sleep 1
systemctl daemon-reload

echo "INFO: defined /etc/fastab"


##
## setup exports
##
cp "${dir}/imp/exports" /etc/exports
systemctl start nfs-kernel-server
systemctl enable nfs-kernel-server
exportfs -a
exportfs -s
echo "INFO: defined /etc/exports"


##
## Done
##

# if we get here, everything worked!
t=$(date)
echo "INFO: network setup done: ${t}"
