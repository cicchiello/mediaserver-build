#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

log=/tmp/setup0.log
t=$(date)
dir=$(cd -- "$(dirname -- "$0")" && pwd)
username=$(basename $(dirname ${dir}))

echo "DEBUG: username: ${username}"

echo "INFO: starting setup0 step: ${t}"

# Setup locale stuff (without going thru raspi-config)
# 1. Un-comment the desired locale in the configuration file
sed -i 's/^# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
# 2. Compile and generate the new locale
locale-gen
# 3. Set the system-wide default language/locale
localectl set-locale LANG=en_US.UTF-8
echo "INFO: locale stuff setup"

echo "INFO: apt-get update"
apt-get update > ${log}

echo "INFO: apt-get upgrade"
apt-get -y upgrade > ${log}

echo "INFO: apt-get install xterm emacs ntfs-3g nfs-common nfs-kernel-server curl apt-transport-https gnupg jq rpi-connect"
apt-get -y install xterm emacs ntfs-3g nfs-common nfs-kernel-server curl apt-transport-https gnupg jq rpi-connect-lite > ${log}

pitools_dir=/home/${username}/pitools
git clone https://github.com/cicchiello/pitools.git ${pitools_dir}
chown -R pi:pi ${pitools_dir}

# install speedtest
curl -s https://packagecloud.io/install/repositories/ookla/speedtest-cli/script.deb.sh | bash
apt-get -y install speedtest

# enable rpi-connect in *user* mode; have to do the signin flow later
sudo -i -u ${username} systemctl --user enable rpi-connect

t=$(date)
echo "INFO: done setup0.bsh: ${t}"

