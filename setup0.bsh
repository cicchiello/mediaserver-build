#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

log=/tmp/setup0.log
t=$(date)
echo "INFO: starting setup0 step: ${t}"

echo "INFO: apt-get update"
apt-get update > ${log}

echo "INFO: apt-get upgrade"
apt-get -y upgrade > ${log}

echo "INFO: apt-get install xterm emacs ntfs-3g nfs-common nfs-kernel-server curl apt-transport-https gnupg jq"
apt-get -y install xterm emacs ntfs-3g nfs-common nfs-kernel-server curl apt-transport-https gnupg jq > ${log}

t=$(date)
echo "INFO: done setup0.bsh: ${t}"

