#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

t=$(date)
echo "INFO: starting: ${t}"

echo "INFO: apt update"
apt update > /tmp/apt-update.log 2>&1

echo "INFO: apt upgrade"
apt -y upgrade > /tmp/apt-upgrade.log 2>&1

echo "INFO: apt install xterm emacs"
apt -y install xterm emacs > /tmp/apt-installs.log 2>&1

t=$(date)
echo "INFO: done: ${t}"

reboot now
