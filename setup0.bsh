#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit
fi

log=/tmp/setup0.log
t=$(date)
echo "INFO: starting setup0 step: ${t}"

echo "INFO: apt update"
apt update > ${log}

echo "INFO: apt upgrade"
apt -y upgrade > ${log}

echo "INFO: apt install xterm emacs ntfs-3g curl apt-transport-https gnupg jq"
apt -y install xterm emacs ntfs-3g curl apt-transport-https gnupg jq > ${log}

t=$(date)
echo "INFO: done setup0.bsh: ${t}"

