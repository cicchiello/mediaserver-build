#!/bin/bash

user=$(whoami)
if [ "$user" != "root" ]
then
    echo "ERROR: Sorry, this shell script must be run as root; perhaps you meant to use \"sudo\"?"
    exit 1
fi

log=/tmp/setup-dvr.log
dir=$(cd -- "$(dirname -- "$0")" && pwd)
username=$(basename $(dirname ${dir}))

##
## Load installation-specific settings
##   Defines: DVR_FS_MOUNT DVR_COUCHDB
##
## Note: ${dir}/dvr-config.sh isn't placed in the repo; but see dvr-config-example.sh
##       for reference
source ${dir}/imp/dvr-config.sh

echo "INFO: apt-get update"
apt-get update > ${log}

echo "INFO: apt-get install xterm emacs ntfs-3g nfs-common nfs-kernel-server python3-pip curl apt-transport-https gnupg jq"
apt-get -y install python3-psutil python3-pip php php-pear php-mysql php8.4-curl php-gd >> ${log}
apt-get -y install apache2 apache2-utils libapache2-mod-php >> ${log}
echo "Apache installations done"

dvr_dir=/home/${username}/dvr
git clone https://github.com/cicchiello/dvr.git "${dvr_dir}"
chown -R "${username}:${username}" "${dvr_dir}"

apt-get -y install python3-psutil
echo "INFO: Python packages installed"

cp ${dir}/imp/dvr-config.ini ${dvr_dir}/py/config.ini


mkdir -p "${DVR_FS_MOUNT}/dvr"
mkdir -p "${DVR_FS_MOUNT}/dvr/raw"
mkdir -p "${DVR_FS_MOUNT}/dvr/compressed"
mkdir -p "${DVR_FS_MOUNT}/dvr/library"
mkdir -p "${DVR_FS_MOUNT}/dvr/trashcan"

mkdir -p "/home/${username}/logs"
chown "${username}:${username}" "/home/${username}/logs"

ln -s "${DVR_FS_MOUNT}/dvr/raw" "${dvr_dir}/py/raw"
ln -s "${DVR_FS_MOUNT}/dvr/compressed" "${dvr_dir}/py/compressed"
ln -s "${DVR_FS_MOUNT}/dvr/library" "${dvr_dir}/py/library"
ln -s "${DVR_FS_MOUNT}/dvr/trashcan" "${dvr_dir}/py/trashcan"

ln -s ${dvr_dir}/www /var/www/html/dvr
echo "INFO: DVR webserver directory setup"

echo "INFO: DVR web site is setup"

cp ${dir}/imp/rc.local /etc/rc.local
chmod a+x /etc/rc.local
chown root:root /etc/rc.local
echo "INFO: /etc/rc.local setup"


inifile="${dvr_dir}/www/config.ini"
echo "; This is the dvr web service ini file" > "${inifile}"
echo "couchbase = ${DVR_COUCHDB}" >> "${inifile}"
chown "${username}:${username}" "${inifile}"


echo "INFO: DVR setup done!"
